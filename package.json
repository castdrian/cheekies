{
	"name": "cheekies",
	"version": "1.29.1",
	"main": "src/main.ts",
	"module": "main.ts",
	"dependencies": {
		"@biomejs/biome": "^1.9.4",
		"@castdrian/kdapi": "0.5.0",
		"@neato/config": "^4.1.0",
		"@prevter/tiktok-scraper": "^1.0.1",
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/framework": "^5.5.1",
		"@sapphire/plugin-logger": "^4.1.0",
		"@the-convocation/twitter-scraper": "^0.22.3",
		"discord.js": "^14.27.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"fast-fuzzy": "^1.12.0",
		"ko-fuzzy": "^1.0.0",
		"systeminformation": "^5.33.7",
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"description": "the all-in-one k-pop discord bot",
	"scripts": {
		"format": "bunx @biomejs/biome check --write .",
		"commit": "git-cz --disable-emoji",
		"cz": "git-cz --disable-emoji",
		"sql-gen": "drizzle-kit generate --config ./src/database/drizzle-config.ts",
		"sql-migrate": "drizzle-kit migrate --config ./src/database/drizzle-config.ts",
		"prepare": "husky .github/husky",
		"start": "bun run src/main.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"devDependencies": {
		"bun-types": "^1.3.14",
		"git-cz": "^4.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"typescript": "^5.8.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild"
	],
	"type": "module"
}
